@page "/"
@using MindHelp.Wasm.Models
@implements IDisposable
@inject SupaBaseService SupabaseService
@inject ChatService Chat
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Startseite</PageTitle>

@if (!_bereit)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}

    else if (_gast)
{
    @* ===== Willkommensseite für Gäste – MudBlazor-Bausteine + Effekte aus app.css (mh-…) ===== *@

    @* Schwebende Farbwolken im Hintergrund *@
    <div class="mh-aurora" aria-hidden="true"><span></span><span></span><span></span></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mh-inhalt pb-10">

        @* ---------- 1. Hero-Bereich ---------- *@
        <MudPaper Elevation="0" Class="mh-glas mh-einblenden pa-6 pa-md-12 rounded-xl">
            <MudGrid Spacing="6" AlignItems="Center">
                <MudItem xs="12" md="7">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.AutoAwesome">
                        Vertraulich · Kostenlos · Sofort
                    </MudChip>

                    <MudText Typo="Typo.h2" Class="mh-schimmer mt-4 mb-3">
                        Du bist nicht allein.
                    </MudText>

                    <MudText Typo="Typo.h6" Class="mh-text mb-8" Style="font-weight: 400; max-width: 520px;">
                        mindhelp verbindet dich mit geprüften Hilfskräften – anonym, sicher und genau dann, wenn du jemanden zum Reden brauchst.
                    </MudText>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3">
                        <MudButton Variant="Variant.Filled" Size="Size.Large" OnClick="ZeigeRegistrierung"
                                   StartIcon="@Icons.Material.Filled.FavoriteBorder" Class="rounded-pill px-6"
                                   Style="text-transform: none; font-weight: 600; color: white; background: linear-gradient(90deg, #7E6FD8, #B48FE0); box-shadow: 0 10px 25px rgba(126,111,216,.4);">
                            Jetzt kostenlos starten
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" OnClick="ZeigeAnmeldung"
                                   Class="mh-knopf-hell rounded-pill px-6" Style="text-transform: none; font-weight: 600;">
                            Ich habe schon ein Konto
                        </MudButton>
                    </MudStack>
                </MudItem>

                <MudItem xs="12" md="5" Class="d-flex justify-center">
                    <div class="mh-logo-buehne">
                        <MudImage Src="images/logo_frei.png" Alt="mindhelp Logo" Width="300" Class="mh-schweben" Style="max-width: 85%; height: auto;" />
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ---------- 2. Drei Vorteile ---------- *@
        <MudGrid Spacing="4" Class="mt-6">
            @for (var i = 0; i < Vorteile.Length; i++)
            {
                var (icon, titel, text) = Vorteile[i];
                var verzoegerung = $"mh-verzoegerung-{i + 1}";
                <MudItem xs="12" md="4">
                    <MudCard Elevation="0" Class="@($"mh-glas mh-karte mh-einblenden {verzoegerung} rounded-xl pa-2")" Style="height: 100%;">
                        <MudCardContent>
                            <MudAvatar Rounded="true" Size="Size.Large" Class="mb-4"
                                       Style="background: linear-gradient(135deg, #7E6FD8, #B48FE0); color: white; border-radius: 16px; box-shadow: 0 8px 20px rgba(126,111,216,.35);">
                                <MudIcon Icon="@icon" />
                            </MudAvatar>
                            <MudText Typo="Typo.h6" Class="mb-2">@titel</MudText>
                            <MudText Typo="Typo.body2" Class="mh-text-leise">@text</MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @* ---------- 3. So funktioniert's ---------- *@
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mh-text mh-einblenden mh-verzoegerung-3 mt-10 mb-5" Style="font-weight: 700;">
            So funktioniert's
        </MudText>
        <MudGrid Spacing="3" Justify="Justify.Center">
            @for (var i = 0; i < Schritte.Length; i++)
            {
                // Werte in eigene Variablen kopieren – sonst sieht Blazor beim Anzeigen nur das letzte i
                var nummer = i + 1;
                var schritt = Schritte[i];
                <MudItem xs="12" sm="4">
                    <MudPaper Elevation="0" Class="mh-glas mh-karte mh-einblenden mh-verzoegerung-4 d-flex align-center gap-3 pa-4 rounded-xl">
                        <MudAvatar Size="Size.Medium" Style="background: linear-gradient(135deg, #7E6FD8, #B48FE0); color: white; font-weight: 700;">@nummer</MudAvatar>
                        <MudText Typo="Typo.body1" Style="font-weight: 500;">@schritt</MudText>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        @* ---------- 4. Notfall-Hinweis ---------- *@
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Phone"
                  Class="mh-notfall mh-einblenden mh-verzoegerung-4 mt-10 rounded-lg">
            <b>In einer akuten Krise?</b> Ruf sofort an: Telefonseelsorge <b>142</b> · Rat auf Draht <b>147</b> ·
            Notruf <b>144</b> – rund um die Uhr und kostenlos.
        </MudAlert>
    </MudContainer>
}

    else
{
    <MudText Typo="Typo.h5" Class="mb-4">Hallo@(string.IsNullOrEmpty(_vorname) ? "" : " " + _vorname)! Wie geht es dir heute?</MudText>

    @if (_meinProfil == null && string.IsNullOrEmpty(_fehler))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            Zu deinem Konto wurde kein Profil gefunden. Bitte melde dich ab und wieder an.
        </MudAlert>
    }

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_fehler</MudAlert>
    }

    <MudGrid>
        @* Linke Spalte: Hilfskräfte (für Hilfesuchende) bzw. Unterhaltungen (für Hilfskräfte) *@
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="pa-2" Style="height: calc(100vh - 200px); overflow-y: auto;">
                <MudText Typo="Typo.subtitle1" Class="pa-2">
                    @(_meinProfil?.IstHilfskraft == true ? "Deine Unterhaltungen" : "Hilfskräfte")
                </MudText>

                <MudList T="string" Dense="true">
                    @if (_meinProfil?.IstHilfskraft == true)
                    {
                        @if (_unterhaltungen.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-2">Noch hat dir niemand geschrieben.</MudText>
                        }
                        @foreach (var (unterhaltung, gegenueber) in _unterhaltungen)
                        {
                            <MudListItem T="string" OnClick="() => OeffneUnterhaltung(unterhaltung, gegenueber)"
                                         Class="@(unterhaltung.Id == _aktiv?.Id ? "mud-selected-item" : "")">
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Secondary" Size="Size.Small" Class="mr-3">@Anfangsbuchstabe(gegenueber)</MudAvatar>
                                    <MudText>@(gegenueber?.VollerName is { Length: > 0 } n ? n : "Unbekannt")</MudText>
                                </div>
                            </MudListItem>
                        }
                    }
                    else
                    {
                        @if (_hilfskraefte.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="pa-2">Derzeit sind keine Hilfskräfte registriert.</MudText>
                        }
                        @foreach (var (profil, details) in _hilfskraefte)
                        {
                            <MudListItem T="string" OnClick="() => StarteChatMit(profil)"
                                         Class="@(profil.Id == _gegenueber?.Id ? "mud-selected-item" : "")">
                                <div class="d-flex align-center">
                                    <MudAvatar Color="Color.Primary" Size="Size.Small" Class="mr-3">@Anfangsbuchstabe(profil)</MudAvatar>
                                    <div>
                                        <MudText>
                                            @profil.VollerName
                                            @if (details?.Verified == true)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" Size="Size.Small" Class="ml-1" Title="verifiziert" />
                                            }
                                        </MudText>
                                        @if (!string.IsNullOrWhiteSpace(details?.Specification))
                                        {
                                            <MudText Typo="Typo.caption">@details.Specification</MudText>
                                        }
                                    </div>
                                </div>
                            </MudListItem>
                        }
                    }
                </MudList>
            </MudPaper>
        </MudItem>

        @* Rechte Spalte: der Chat *@
        <MudItem xs="12" md="8">
            <MudPaper Elevation="2" Class="d-flex flex-column" Style="height: calc(100vh - 200px);">
                @if (_aktiv == null)
                {
                    <div class="d-flex flex-grow-1 align-center justify-center pa-4">
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            @(_meinProfil?.IstHilfskraft == true
                                ? "Wähle links eine Unterhaltung aus."
                                : "Wähle links eine Hilfskraft aus, um zu schreiben.")
                        </MudText>
                    </div>
                }
                else
                {
                    @* Kopfzeile *@
                    <div class="d-flex align-center pa-3" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                        <MudAvatar Color="Color.Primary" Class="mr-3">@Anfangsbuchstabe(_gegenueber)</MudAvatar>
                        <MudText Typo="Typo.subtitle1">@(_gegenueber?.VollerName is { Length: > 0 } n ? n : "Unterhaltung")</MudText>
                    </div>

                    @* Nachrichten *@
                    <div id="chat-verlauf" class="flex-grow-1 pa-4" style="overflow-y: auto;">
                        @if (_nachrichten.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Noch keine Nachrichten. Schreib die erste!</MudText>
                        }
                        @foreach (var nachricht in _nachrichten)
                        {
                            var vonMir = nachricht.SenderId == _meineId;
                            <div class="d-flex mb-3 @(vonMir ? "justify-end" : "justify-start")">
                                <MudPaper Elevation="0" Class="pa-3"
                                          Style="@($"max-width: 70%; border-radius: 16px; background-color: {(vonMir ? "var(--mud-palette-primary)" : "var(--mud-palette-gray-light)")}; color: {(vonMir ? "white" : "inherit")};")">
                                    <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@nachricht.Content</MudText>
                                    <MudText Typo="Typo.caption" Style="opacity: 0.7;">@nachricht.CreatedAt.ToLocalTime().ToString("dd.MM. HH:mm")</MudText>
                                </MudPaper>
                            </div>
                        }
                    </div>

                    @* Eingabezeile *@
                    <div class="d-flex align-center pa-3" style="border-top: 1px solid var(--mud-palette-lines-default);">
                        <MudTextField @bind-Value="_neueNachricht" Placeholder="Nachricht schreiben …" Variant="Variant.Outlined"
                                      Margin="Margin.Dense" Immediate="true" OnKeyDown="OnKeyDown" Class="mr-2" />
                        <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Primary" Variant="Variant.Filled"
                                       Disabled="@(_sendet || string.IsNullOrWhiteSpace(_neueNachricht))" OnClick="Senden" />
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private bool _bereit;
    private bool _gast;          // true = noch nicht angemeldet
    private bool _sendet;
    private string _fehler = "";
    private string _neueNachricht = "";

    private Guid? _meineId;
    private Profile? _meinProfil;
    private string _vorname = "";
    private List<(Profile Profil, HelperDetails? Details)> _hilfskraefte = [];
    private List<(Conversation Unterhaltung, Profile? Gegenueber)> _unterhaltungen = [];

    private Conversation? _aktiv;        // gerade geöffnete Unterhaltung
    private Profile? _gegenueber;        // Person, mit der man gerade chattet
    private List<ChatMessage> _nachrichten = [];

    protected override async Task OnInitializedAsync()
    {
        await SupabaseService.InitializeAsync();
        SupabaseService.AnmeldungGeaendert += BeiAnmeldungGeaendert;
        Chat.NeueNachricht += BeiNeuerNachricht;
        await LadeDatenAsync();
    }

    // Lädt alles neu – beim Öffnen der Seite und nach dem An- oder Abmelden
    private async Task LadeDatenAsync()
    {
        _bereit = false;
        _fehler = "";
        _aktiv = null;
        _gegenueber = null;
        _nachrichten = [];
        _hilfskraefte = [];
        _unterhaltungen = [];
        _meinProfil = null;
        _vorname = "";

        _gast = !SupabaseService.IsLoggedIn;
        if (_gast)
        {
            Chat.StoppeLiveEmpfang();
            _bereit = true;
            return;
        }

        try
        {
            _meineId = await Chat.GetMeineIdAsync();
            _meinProfil = await Chat.GetMeinProfilAsync();
            _vorname = await Chat.GetMeinVornameAsync(_meinProfil);

            if (_meinProfil?.IstHilfskraft == true)
                _unterhaltungen = await Chat.GetMeineUnterhaltungenAsync();
            else
                _hilfskraefte = await Chat.GetHilfskraefteAsync();
        }
        catch (Exception ex)
        {
            _fehler = "Daten konnten nicht geladen werden: " + ex.Message;
        }

        try
        {
            // Neue Nachrichten live empfangen
            await Chat.StarteLiveEmpfangAsync();
        }
        catch (Exception ex)
        {
            // Chat funktioniert trotzdem, neue Nachrichten erscheinen dann erst nach dem Neuladen
            Console.WriteLine("Live-Empfang nicht möglich: " + ex.Message);
        }

        _bereit = true;
    }

        // Inhalte der Willkommensseite (so muss man den Aufbau oben nur einmal schreiben)
    private static readonly (string Icon, string Titel, string Text)[] Vorteile =
    [
        (Icons.Material.Filled.Lock, "Anonym & vertraulich", "Deine Gespräche sieht nur die Hilfskraft, mit der du schreibst. Niemand sonst."),
        (Icons.Material.Filled.Verified, "Geprüfte Hilfskräfte", "Alle Hilfskräfte weisen ihre Ausbildung nach und werden von uns überprüft."),
        (Icons.Material.Filled.ChatBubbleOutline, "Einfach schreiben", "Kein Termin, kein Telefonat – du schreibst einfach los, wann es für dich passt.")
    ];

    private static readonly string[] Schritte =
    [
        "Registriere dich in einer Minute",
        "Wähle eine Hilfskraft, die zu dir passt",
        "Schreib einfach los – wir hören zu"
    ];

        // Registrierungs-Fenster öffnen (Knopf "Jetzt kostenlos starten")
    private async Task ZeigeRegistrierung()
    {
        var optionen = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<MindHelp.Wasm.Layout.RegisterDialog>(string.Empty, optionen);
    }


    // Anmelde-Fenster öffnen (Knopf "Ich habe schon ein Konto")
    private async Task ZeigeAnmeldung()
    {
        var optionen = new DialogOptions { BackdropClick = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<MindHelp.Wasm.Layout.LoginDialog>(string.Empty, optionen);
    }

    private void BeiAnmeldungGeaendert()
    {
        _ = InvokeAsync(async () =>
        {
            await LadeDatenAsync();
            StateHasChanged();
        });
    }

    // Hilfesuchende/r klickt auf eine Hilfskraft
    private async Task StarteChatMit(Profile hilfskraft)
    {
        try
        {
            var unterhaltung = await Chat.GetOderStarteUnterhaltungAsync(hilfskraft.Id);
            if (unterhaltung != null)
                await OeffneUnterhaltung(unterhaltung, hilfskraft);
        }
        catch (Exception ex)
        {
            _fehler = "Unterhaltung konnte nicht gestartet werden: " + ex.Message;
        }
    }

    private async Task OeffneUnterhaltung(Conversation unterhaltung, Profile? gegenueber)
    {
        _aktiv = unterhaltung;
        _gegenueber = gegenueber;
        _nachrichten = await Chat.GetNachrichtenAsync(unterhaltung.Id);
    }

    private async Task Senden()
    {
        if (_aktiv == null || string.IsNullOrWhiteSpace(_neueNachricht)) return;

        _sendet = true;
        var text = _neueNachricht;
        _neueNachricht = "";

        try
        {
            var gesendet = await Chat.SendeNachrichtAsync(_aktiv.Id, text);
            // Die eigene Nachricht sofort anzeigen (Live-Empfang könnte sie später nochmal liefern)
            if (gesendet != null && _nachrichten.All(n => n.Id != gesendet.Id))
                _nachrichten.Add(gesendet);
        }
        catch (Exception ex)
        {
            _fehler = "Nachricht konnte nicht gesendet werden: " + ex.Message;
            _neueNachricht = text;
        }

        _sendet = false;
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await Senden();
    }

    // Wird vom Live-Empfang aufgerufen (läuft außerhalb von Blazor, deshalb InvokeAsync)
    private void BeiNeuerNachricht(ChatMessage nachricht)
    {
        _ = InvokeAsync(async () =>
        {
            if (_aktiv != null && nachricht.ConversationId == _aktiv.Id)
            {
                if (_nachrichten.All(n => n.Id != nachricht.Id))
                    _nachrichten.Add(nachricht);
            }
            else if (_meinProfil?.IstHilfskraft == true && _unterhaltungen.All(u => u.Unterhaltung.Id != nachricht.ConversationId))
            {
                // Eine neue Person hat der Hilfskraft geschrieben → Liste neu laden
                _unterhaltungen = await Chat.GetMeineUnterhaltungenAsync();
            }
            StateHasChanged();
        });
    }

    private static string Anfangsbuchstabe(Profile? profil) =>
        string.IsNullOrWhiteSpace(profil?.FirstName) ? "?" : profil.FirstName[..1].ToUpper();

    public void Dispose()
    {
        SupabaseService.AnmeldungGeaendert -= BeiAnmeldungGeaendert;
        Chat.NeueNachricht -= BeiNeuerNachricht;
        Chat.StoppeLiveEmpfang();
    }
}