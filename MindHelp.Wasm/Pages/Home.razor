@page "/"
@using MindHelp.Wasm.Models
@implements IDisposable
@inject SupaBaseService SupabaseService
@inject ChatService Chat
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Startseite</PageTitle>

@if (!_bereit)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_gast)
{
    @* ===== Willkommensseite für Gäste – MudBlazor-Bausteine + Effekte aus app.css (mh-…) ===== *@

    @* Schwebende Farbwolken im Hintergrund *@
    <div class="mh-aurora" aria-hidden="true"><span></span><span></span><span></span></div>

    <MudContainer MaxWidth="MaxWidth.Large" Class="mh-inhalt pb-10">

        @* ---------- 1. Hero-Bereich ---------- *@
        <MudPaper Elevation="0" Class="mh-glas mh-einblenden mh-hero pa-6 pa-md-12 rounded-xl">
            <MudGrid Spacing="6" Class="align-center">
                @* Am Handy steht das Logo oben (CSS: .mh-hero-logo), am Laptop rechts *@
                <MudItem xs="12" md="5" Class="d-flex justify-center mh-hero-logo">
                    <div class="mh-logo-buehne">
                        <MudImage Src="images/logo_frei.png" Alt="mindhelp Logo" Class="mh-schweben mh-logo-bild" />
                    </div>
                </MudItem>

                <MudItem xs="12" md="7" Class="mh-hero-text">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Medium"
                             Icon="@Icons.Material.Filled.AutoAwesome">
                        Vertraulich · Kostenlos · Sofort
                    </MudChip>

                    <MudText Typo="Typo.h2" Class="mh-schimmer mh-titel mt-4 mb-3">
                        Du bist nicht allein.
                    </MudText>

                    <MudText Typo="Typo.h6" Class="mh-text mh-untertitel mb-8">
                        mindhelp verbindet dich mit geprüften Hilfskräften – anonym, sicher und genau dann, wenn du jemanden zum Reden brauchst.
                    </MudText>

                    <div class="mh-hero-knoepfe">
                        <MudButton Variant="Variant.Filled" Size="Size.Large" OnClick="ZeigeRegistrierung"
                                   StartIcon="@Icons.Material.Filled.FavoriteBorder" Class="rounded-pill px-6 mh-knopf-haupt">
                            Jetzt kostenlos starten
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" OnClick="ZeigeAnmeldung"
                                   Class="mh-knopf-hell rounded-pill px-6" Style="text-transform: none; font-weight: 600;">
                            Ich habe schon ein Konto
                        </MudButton>
                    </div>

                    @* Vertrauens-Zeile *@
                    <div class="mh-vertrauen mt-6">
                        @foreach (var (icon, text) in Vertrauen)
                        {
                            <span class="mh-vertrauen-punkt"><MudIcon Icon="@icon" Size="Size.Small" /> @text</span>
                        }
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ---------- 2. Drei Vorteile ---------- *@
        <MudGrid Spacing="4" Class="mt-6">
            @for (var i = 0; i < Vorteile.Length; i++)
            {
                var (icon, titel, text) = Vorteile[i];
                var verzoegerung = $"mh-verzoegerung-{i + 1}";
                <MudItem xs="12" md="4">
                    <MudCard Elevation="0" Class="@($"mh-glas mh-karte mh-einblenden {verzoegerung} rounded-xl pa-2 mh-vorteil")" Style="height: 100%;">
                        <MudCardContent Class="d-flex flex-md-column gap-4 align-start">
                            <div class="mh-icon-kachel"><MudIcon Icon="@icon" /></div>
                            <div>
                                <MudText Typo="Typo.h6" Class="mb-1">@titel</MudText>
                                <MudText Typo="Typo.body2" Class="mh-text-leise">@text</MudText>
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        @* ---------- 3. Was die App kann ---------- *@
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mh-text mh-abschnitt mh-einblenden mh-verzoegerung-3 mt-10 mb-2">
            Alles, was du brauchst
        </MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mh-text-leise mb-5">
            Mehr als ein Chat – kleine Helfer für jeden Tag.
        </MudText>
        <div class="mh-funktionen">
            @foreach (var (icon, titel, text, notfall) in Funktionen)
            {
                <MudPaper Elevation="0" Class="@($"mh-glas mh-karte mh-funktion rounded-xl pa-4 {(notfall ? "mh-funktion-notfall" : "")}")">
                    <div class="@($"mh-icon-kachel mh-icon-klein {(notfall ? "mh-icon-notfall" : "")}")"><MudIcon Icon="@icon" Size="Size.Small" /></div>
                    <MudText Typo="Typo.subtitle1" Class="mt-3" Style="font-weight: 700;">@titel</MudText>
                    <MudText Typo="Typo.body2" Class="mh-text-leise">@text</MudText>
                </MudPaper>
            }
        </div>

        @* ---------- 4. So funktioniert's (am Handy als Zeitleiste) ---------- *@
        <MudText Typo="Typo.h4" Align="Align.Center" Class="mh-text mh-abschnitt mh-einblenden mh-verzoegerung-3 mt-10 mb-5">
            So funktioniert's
        </MudText>
        <div class="mh-schritte">
            @for (var i = 0; i < Schritte.Length; i++)
            {
                // Werte in eigene Variablen kopieren – sonst sieht Blazor beim Anzeigen nur das letzte i
                var nummer = i + 1;
                var schritt = Schritte[i];
                <div class="mh-schritt">
                    <span class="mh-schritt-nummer">@nummer</span>
                    <MudPaper Elevation="0" Class="mh-glas rounded-xl pa-4 flex-grow-1">
                        <MudText Typo="Typo.body1" Style="font-weight: 600;">@schritt</MudText>
                    </MudPaper>
                </div>
            }
        </div>

        @* ---------- 5. Abschluss ---------- *@
        <MudPaper Elevation="0" Class="mh-abschluss rounded-xl pa-8 mt-10 text-center">
            <MudText Typo="Typo.h5" Style="font-weight: 800; color: white;">Du musst das nicht allein schaffen.</MudText>
            <MudText Typo="Typo.body1" Class="mt-2 mb-5" Style="color: rgba(255,255,255,.9);">
                In einer Minute registriert – und jemand hört dir zu.
            </MudText>
            <MudButton Variant="Variant.Filled" Size="Size.Large" OnClick="ZeigeRegistrierung" Class="rounded-pill px-8 mh-knopf-weiss">
                Jetzt kostenlos starten
            </MudButton>
        </MudPaper>

        @* ---------- 6. Notfall-Hinweis ---------- *@
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Phone"
                  Class="mh-notfall mt-6 rounded-lg">
            <b>In einer akuten Krise?</b> Ruf sofort an: Telefonseelsorge <b>142</b> · Rat auf Draht <b>147</b> ·
            Notruf <b>144</b> – rund um die Uhr und kostenlos.
        </MudAlert>
    </MudContainer>
}
else
{
    @* ---------- Chatliste (wie bei WhatsApp) ---------- *@
    <MudContainer MaxWidth="MaxWidth.Small" Class="px-0">
        <MudText Typo="Typo.h5" Class="mh-text mb-1" Style="font-weight: 700;">Chats</MudText>
        <MudText Typo="Typo.body2" Class="mh-text-leise mb-3">
            Hallo@(string.IsNullOrEmpty(_vorname) ? "" : " " + _vorname)! @(_istHilfskraft ? "Hier sind deine Unterhaltungen." : "Schreib einer Hilfskraft, wann immer du magst.")
        </MudText>

        @if (!string.IsNullOrEmpty(_fehler))
        {
            <MudAlert Severity="Severity.Error" Class="mb-3">@_fehler</MudAlert>
        }

        <MudTextField @bind-Value="_suche" Placeholder="@(_istHilfskraft ? "Unterhaltung suchen" : "Hilfskraft suchen")"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Class="mh-suche mb-3" />

        @if (_istHilfskraft)
        {
            <MudChipSet T="string" @bind-SelectedValue="_filter" SelectionMode="SelectionMode.SingleSelection" CheckMark="false" Class="mb-3">
                <MudChip T="string" Value="@("alle")" Text="Alle" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="string" Value="@("ungelesen")" Text="Ungelesen" Color="Color.Primary" Variant="Variant.Outlined" />
                <MudChip T="string" Value="@("notfall")" Text="Notfälle" Color="Color.Error" Variant="Variant.Outlined" />
            </MudChipSet>
        }

        <MudPaper Elevation="0" Class="mh-glas rounded-xl pa-1">
            @{
                var mitChat = Gefiltert.Where(e => e.Unterhaltung != null).ToList();
                var ohneChat = Gefiltert.Where(e => e.Unterhaltung == null).ToList();
            }

            @if (mitChat.Count == 0 && ohneChat.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mh-text-leise pa-4">
                    @(_istHilfskraft ? "Noch hat dir niemand geschrieben." : "Nichts gefunden.")
                </MudText>
            }

            @foreach (var eintrag in mitChat)
            {
                @ChatZeile(eintrag)
            }

            @if (ohneChat.Count > 0)
            {
                <MudText Typo="Typo.overline" Class="mh-text-leise d-block px-3 pt-3">Weitere Hilfskräfte</MudText>
                @foreach (var eintrag in ohneChat)
                {
                    @ChatZeile(eintrag)
                }
            }
        </MudPaper>

        @if (!_istHilfskraft)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Icon="@Icons.Material.Filled.Phone" Class="mh-notfall mt-4 rounded-lg">
                <b>In einer akuten Krise?</b> Tippe oben auf <b>SOS</b> oder ruf an: Telefonseelsorge <b>142</b> · Notruf <b>144</b>
            </MudAlert>
        }
    </MudContainer>
}

@code {
    // Eine Zeile der Chatliste (als Vorlage, damit sie oben zweimal verwendet werden kann)
    private RenderFragment ChatZeile(ChatEintrag eintrag) => __builder =>
    {
        var letzte = eintrag.LetzteNachricht;
        var vonMir = letzte != null && letzte.SenderId == _meineId;
        <div class="mh-chatzeile" role="button" tabindex="0" @onclick="() => Oeffne(eintrag)">
            <MudBadge Dot="true" Color="Color.Success" Overlap="true" Bordered="true" Origin="Origin.BottomRight"
                      Visible="@(eintrag.Details?.Erreichbar == true)">
                <MudAvatar Size="Size.Large" Class="@(eintrag.Notfall ? "mh-avatar mh-avatar-notfall" : "mh-avatar")">@Anfangsbuchstabe(eintrag.Gegenueber)</MudAvatar>
            </MudBadge>

            <div class="flex-grow-1" style="min-width: 0;">
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.subtitle1" Class="mh-einzeilig" Style="font-weight: 600;">@Name(eintrag.Gegenueber)</MudText>
                    @if (eintrag.Details?.Verified == true)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" Style="font-size: 16px;" Title="verifiziert" />
                    }
                    @if (eintrag.Notfall)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text" Class="ma-0">Notfall</MudChip>
                    }
                </div>
                <MudText Typo="Typo.body2" Class="@($"mh-einzeilig {(eintrag.Ungelesen > 0 ? "" : "mh-text-leise")}")"
                         Style="@(eintrag.Ungelesen > 0 ? "font-weight: 600;" : "")">
                    @if (vonMir)
                    {
                        <MudIcon Icon="@(letzte!.SeenAt != null ? Icons.Material.Filled.DoneAll : Icons.Material.Filled.Done)"
                                 Color="@(letzte.SeenAt != null ? Color.Info : Color.Default)" Style="font-size: 16px; vertical-align: -3px;" />
                    }
                    @(letzte?.Content ?? Untertitel(eintrag))
                </MudText>
            </div>

            <div class="d-flex flex-column align-end gap-1">
                @if (letzte != null)
                {
                    <MudText Typo="Typo.caption" Color="@(eintrag.Ungelesen > 0 ? Color.Primary : Color.Secondary)"
                             Style="@(eintrag.Ungelesen > 0 ? "font-weight: 700;" : "")">@Zeit(letzte.CreatedAt)</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text" Class="ma-0">Chat starten</MudChip>
                }
                @if (eintrag.Ungelesen > 0)
                {
                    <span class="@($"mh-zaehler {(eintrag.Notfall ? "mh-zaehler-notfall" : "")}")">@eintrag.Ungelesen</span>
                }
            </div>
        </div>
    };
}

@code {
    private bool _bereit;
    private bool _gast;          // true = noch nicht angemeldet
    private bool _istHilfskraft;
    private string _fehler = "";
    private string _vorname = "";
    private string _suche = "";
    private string _filter = "alle";

    private Guid? _meineId;
    private List<ChatEintrag> _eintraege = [];

    // Suche und Filter (Alle / Ungelesen / Notfälle) anwenden
    private IEnumerable<ChatEintrag> Gefiltert => _eintraege
        .Where(e => string.IsNullOrWhiteSpace(_suche) || Name(e.Gegenueber).Contains(_suche, StringComparison.OrdinalIgnoreCase))
        .Where(e => _filter != "ungelesen" || e.Ungelesen > 0)
        .Where(e => _filter != "notfall" || e.Notfall);

    protected override async Task OnInitializedAsync()
    {
        await SupabaseService.InitializeAsync();
        SupabaseService.AnmeldungGeaendert += BeiAnmeldungGeaendert;
        Chat.NeueNachricht += BeiNeuerNachricht;
        Chat.NachrichtGeaendert += BeiNeuerNachricht;
        await LadeDatenAsync();
    }

    // Lädt alles neu – beim Öffnen der Seite und nach dem An- oder Abmelden
    private async Task LadeDatenAsync()
    {
        _bereit = false;
        _fehler = "";
        _eintraege = [];

        _gast = !SupabaseService.IsLoggedIn;
        if (_gast)
        {
            _bereit = true;
            return;
        }

        try
        {
            _meineId = await Chat.GetMeineIdAsync();
            var profil = await Chat.GetMeinProfilAsync();
            _istHilfskraft = profil?.IstHilfskraft == true;
            _vorname = await Chat.GetMeinVornameAsync(profil);
            _eintraege = await Chat.GetChatListeAsync(_istHilfskraft);
        }
        catch (Exception ex)
        {
            _fehler = "Daten konnten nicht geladen werden: " + ex.Message;
        }

        _bereit = true;
    }

    // Inhalte der Willkommensseite (so muss man den Aufbau oben nur einmal schreiben)
    private static readonly (string Icon, string Titel, string Text)[] Vorteile =
    [
        (Icons.Material.Filled.Lock, "Anonym & vertraulich", "Deine Gespräche sieht nur die Hilfskraft, mit der du schreibst. Niemand sonst."),
        (Icons.Material.Filled.Verified, "Geprüfte Hilfskräfte", "Alle Hilfskräfte weisen ihre Ausbildung nach und werden von uns überprüft."),
        (Icons.Material.Filled.ChatBubbleOutline, "Einfach schreiben", "Kein Termin, kein Telefonat – du schreibst einfach los, wann es für dich passt.")
    ];

    private static readonly (string Icon, string Text)[] Vertrauen =
    [
        (Icons.Material.Filled.Lock, "Anonym"),
        (Icons.Material.Filled.Verified, "Geprüfte Fachkräfte"),
        (Icons.Material.Filled.Favorite, "Kostenlos")
    ];

    // Was die App kann (Notfall = roter Akzent)
    private static readonly (string Icon, string Titel, string Text, bool Notfall)[] Funktionen =
    [
        (Icons.Material.Filled.Chat, "Chat", "Schreib mit geprüften Fachkräften – wann es dir passt.", false),
        (Icons.Material.Filled.Campaign, "SOS-Knopf", "Ein Tipp, und alle verfügbaren Fachkräfte werden alarmiert.", true),
        (Icons.Material.Filled.Mood, "Wie geht's dir?", "Dein Stimmungstagebuch mit Wochenkurve.", false),
        (Icons.Material.Filled.FactCheck, "Kurz-Check", "Fünf Fragen zu deinem Wohlbefinden.", false)
    ];

    private static readonly string[] Schritte =
    [
        "Registriere dich in einer Minute",
        "Wähle eine Hilfskraft, die zu dir passt",
        "Schreib einfach los – wir hören zu"
    ];

    // Registrierungs-Fenster öffnen (Knopf "Jetzt kostenlos starten")
    private async Task ZeigeRegistrierung()
    {
        var optionen = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<MindHelp.Wasm.Layout.RegisterDialog>(string.Empty, optionen);
    }

    // Anmelde-Fenster öffnen (Knopf "Ich habe schon ein Konto")
    private async Task ZeigeAnmeldung()
    {
        var optionen = new DialogOptions { BackdropClick = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        await DialogService.ShowAsync<MindHelp.Wasm.Layout.LoginDialog>(string.Empty, optionen);
    }

    private void BeiAnmeldungGeaendert()
    {
        _ = InvokeAsync(async () =>
        {
            await LadeDatenAsync();
            StateHasChanged();
        });
    }

    // Chat öffnen – bei einer neuen Hilfskraft wird die Unterhaltung zuerst angelegt
    private async Task Oeffne(ChatEintrag eintrag)
    {
        try
        {
            var unterhaltung = eintrag.Unterhaltung ?? await Chat.GetOderStarteUnterhaltungAsync(eintrag.Gegenueber.Id);
            if (unterhaltung != null)
                Nav.NavigateTo($"chat/{unterhaltung.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Chat konnte nicht geöffnet werden: " + ex.Message, Severity.Error);
        }
    }

    // Neue oder gelesene Nachricht → Liste neu laden (letzte Nachricht, Zähler, Häkchen)
    private void BeiNeuerNachricht(ChatMessage nachricht)
    {
        if (_gast) return;
        _ = InvokeAsync(async () =>
        {
            try { _eintraege = await Chat.GetChatListeAsync(_istHilfskraft); } catch { /* beim nächsten Mal */ }
            StateHasChanged();
        });
    }

    private static string Anfangsbuchstabe(Profile? profil) =>
        string.IsNullOrWhiteSpace(profil?.FirstName) ? "?" : profil.FirstName[..1].ToUpper();

    private static string Name(Profile profil) => profil.VollerName is { Length: > 0 } n ? n : "Unbekannt";

    private static string Untertitel(ChatEintrag eintrag)
    {
        if (eintrag.Details == null) return "Hilfesuchend";
        var fach = string.IsNullOrWhiteSpace(eintrag.Details.Specification) ? "Hilfskraft" : eintrag.Details.Specification;
        return eintrag.Details.Erreichbar ? fach : fach + " · gerade nicht erreichbar";
    }

    // Wie bei WhatsApp: heute → Uhrzeit, gestern → "gestern", sonst Datum
    private static string Zeit(DateTime zeit)
    {
        var lokal = zeit.ToLocalTime();
        if (lokal.Date == DateTime.Today) return lokal.ToString("HH:mm");
        if (lokal.Date == DateTime.Today.AddDays(-1)) return "gestern";
        return lokal.ToString("dd.MM.");
    }

    public void Dispose()
    {
        SupabaseService.AnmeldungGeaendert -= BeiAnmeldungGeaendert;
        Chat.NeueNachricht -= BeiNeuerNachricht;
        Chat.NachrichtGeaendert -= BeiNeuerNachricht;
    }
}