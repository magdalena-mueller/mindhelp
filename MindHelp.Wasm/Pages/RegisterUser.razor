@page "/RegisterUser"
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Nav
@inject SupaBaseService SupabaseService

<PageTitle>Registrieren</PageTitle>

<MudText Typo="Typo.h5" Class="mb-4">Registrieren als hilfesuchende Person</MudText>

<MudGrid>
    <MudItem xs="12" sm="7">
        <MudPaper Class="pa-4">
            <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors">
                <MudTextField T="string" Label="Vorname" @bind-Value="@_vorname" Required="true" RequiredError="Vorname wird benötigt!" />
                <MudTextField T="string" Label="Nachname" @bind-Value="@_nachname" Required="true" RequiredError="Nachname wird benötigt!" />
                <MudTextField T="string" Label="E-Mail" @bind-Value="@_email" Required="true" RequiredError="E-Mail wird benötigt!"
                              Validation="@(new EmailAddressAttribute { ErrorMessage = "Die E-Mail-Adresse ist ungültig" })" />
                <MudTextField T="string" Label="Passwort" @bind-Value="@_password"
                              HelperText="Mindestens 8 Zeichen, Groß- und Kleinbuchstaben und eine Zahl"
                              InputType="InputType.Password"
                              Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                              Required="true" RequiredError="Passwort wird benötigt!" />
                <MudTextField T="string" Label="Passwort wiederholen" InputType="InputType.Password"
                              Validation="@(new Func<string, string?>(PasswordMatch))" />
                <MudTextField T="DateTime?" Label="Geburtsdatum" Format="yyyy-MM-dd" InputType="InputType.Date"
                              @bind-Value="@_birthday" Required="true" RequiredError="Geburtsdatum wird benötigt!" />

                <div class="d-flex align-center justify-space-between mt-4">
                    <MudCheckBox T="bool" @bind-Value="_agree" Required="true" RequiredError="Bitte zustimmen" Label="Ich stimme zu" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto"
                               Disabled="@(!_success || _laeuft)" OnClick="Register">Registrieren</MudButton>
                </div>
            </MudForm>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="5">
        <MudPaper Class="pa-4 mud-height-full">
            <MudText Typo="Typo.subtitle2">@($"Fehler ({_errors.Length})")</MudText>
            @foreach (var error in _errors)
            {
                <MudText Color="@Color.Error">@error</MudText>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private MudForm _form = null!;
    private bool _success;
    private bool _agree;
    private bool _laeuft;
    private string _vorname = "";
    private string _nachname = "";
    private string _email = "";
    private string _password = "";
    private DateTime? _birthday;
    private string _specification = "";
    private string[] _errors = [];

    private async Task Register()       // Button-Klick zum Speichern
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || !_birthday.HasValue) return;

        _laeuft = true;
        // "user" sagt der Datenbank, ob eine hilfesuchende Person registriert wird
        var ok = await SupabaseService.RegisterUserAsync(_email, _password, _vorname, _nachname, _birthday.Value, _specification, "user");
        _laeuft = false;

        if (ok)
            Nav.NavigateTo("/");   // Startseite: angemeldet → Chat, sonst → Anmeldung
        else
            _errors = ["Registrierung fehlgeschlagen. Ist die E-Mail-Adresse vielleicht schon registriert?"];
    }

    private static IEnumerable<string> PasswordStrength(string pw)
    {
        if (string.IsNullOrWhiteSpace(pw))
        {
            yield return "Passwort wird benötigt!";
            yield break;
        }
        if (pw.Length < 8)
            yield return "Das Passwort muss mindestens 8 Zeichen lang sein";
        if (!Regex.IsMatch(pw, @"[A-Z]"))
            yield return "Das Passwort braucht mindestens einen Großbuchstaben";
        if (!Regex.IsMatch(pw, @"[a-z]"))
            yield return "Das Passwort braucht mindestens einen Kleinbuchstaben";
        if (!Regex.IsMatch(pw, @"[0-9]"))
            yield return "Das Passwort braucht mindestens eine Zahl";
    }

    private string? PasswordMatch(string arg) => _password != arg ? "Die Passwörter stimmen nicht überein" : null;
}