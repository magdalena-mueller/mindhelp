    private async Task ShowMessageBox()         //MessageBox Results glaub ich
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Achtung",
            "Sind Sie Hilfesuchend oder bieten Sie psychologische Hilfe an?",
            yesText: "Hilfeskraft",
            noText: "Hilfesuchend",
            cancelText: "Abbrechen");

        _result = result switch
        {
            true  => "Ja",
            false => "Nein",
            null  => "Abbrechen"
        };

        if (_result == "Nein")
        {
            Nav.NavigateTo("/RegisterUser");
        }
        else if (_result == "Ja")
        {
            Nav.NavigateTo("/RegisterHelper");
        }
    }
}