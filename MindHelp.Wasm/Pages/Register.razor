@page "/Register"
@page "/messagebox2"
@inject IDialogService DialogService
@inject NavigationManager Nav

@* Alte Registrierungs-Seite: öffnet jetzt einfach das neue Registrierungs-Fenster *@
<PageTitle>Registrieren</PageTitle>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var optionen = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        var fenster = await DialogService.ShowAsync<MindHelp.Wasm.Layout.RegisterDialog>(string.Empty, optionen);
        await fenster.Result;

        // Nach dem Schließen zurück zur Startseite
        Nav.NavigateTo("/");
    }
}