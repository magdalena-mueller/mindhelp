@page "/Register"
@page "/messagebox2"

// Die drei Zeilen von Mathias
 @*page "/user"
@inject SupaBaseService SupabaseService
@inject NavigationManager Nav*@

<PageTitle>Registrieren</PageTitle>

@inject IDialogService DialogService
@inject SupaBaseService SupabaseService
@inject HttpClient Http
@inject NavigationManager Nav


<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           OnClick="ShowMessageBox">
    MessageBox anzeigen
</MudButton> 

<MudText Class="mt-4">Ergebnis: @_result</MudText>

@code {

    // wieder einkommentiert
    protected override async Task OnInitializedAsync()
    {
        await SupabaseService.InitializeAsync();

        if (!SupabaseService.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

    } 
    
    private string _result = string.Empty;
    protected override async Task OnAfterRenderAsync(bool firstRender)      //MessageBox zum Auswählen was man ist
    {
        if (firstRender)
        {
            await ShowMessageBox();
        }
    }

    private async Task ShowMessageBox()         //MessageBox Results glaub ich
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            "Achtung",
            "Sind Sie Hilfesuchend oder bieten Sie psychologische Hilfe an?",
            yesText: "Hilfeskraft",
            noText: "Hilfesuchend",
            cancelText: "Abbrechen");

        _result = result switch
        {
            true  => "Ja",
            false => "Nein",
            null  => "Abbrechen"
        };

        if (_result == "Ja")
        {
            Nav.NavigateTo("/PHelp");
        }
        else if (_result == "Nein")
        {
            Nav.NavigateTo("/User");
        }
    }
}
