@inherits LayoutComponentBase
@implements IDisposable
@inject SupaBaseService SupabaseService
@inject ChatService Chat
@inject NotrufService NotrufDienst
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject DesignService Design
@inject IJSRuntime JS

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" />

@* "mh-dunkel" schaltet die eigenen Farben (app.css) in den dunklen Modus – auch für Fenster und Menüs *@
<div class="@(_isDarkMode ? "mh-dunkel" : "")">
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
    <MudText Typo="Typo.h6" Class="ml-1 mh-logo-text" Style="font-weight: 800;">mindhelp</MudText>
        <MudSpacer />

        @* Hilfesuchende: roter SOS-Knopf, immer erreichbar *@
        @if (_angemeldet && _profil != null && !_profil.IstHilfskraft)
        {
            var wartet = NotrufDienst.MeinNotruf?.Status == "offen";
            <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Campaign"
                       Class="@($"rounded-pill mr-2 {(wartet ? "mh-blinken" : "")}")" OnClick="ZeigeNotruf">
                @(wartet ? "wartet …" : "SOS")
            </MudButton>
        }

       

        @if (!_angemeldet)
        {
                       @* Login und Registrieren klein und als Paar – passt auch am Handy *@
            <div class="mh-anmelde-knoepfe">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="rounded-pill mh-knopf-klein"
                           OnClick="ZeigeLoginFenster">Login</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="rounded-pill mh-knopf-klein"
                           DropShadow="false" OnClick="ZeigeRegistrierung">Registrieren</MudButton>
            </div>
        }
    </MudAppBar>

    @* Hilfskräfte: Notruf-Hinweis oben, egal auf welcher Seite *@
    @if (_angemeldet && _profil?.IstHilfskraft == true && _verifiziert)
    {
        <NotrufBanner />
    }

        @* Laptop: Menü links. Unter der Breite "Md" (Handy, kleines Tablet) klappt MudBlazor es von selbst weg –
       dort gibt es stattdessen die Leiste unten. *@
    @if (_angemeldet && _profil != null)
    {
        <MudDrawer @bind-Open="_menuOffen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md"
                   ClipMode="DrawerClipMode.Always" Elevation="0">
            <NavMenu IstHilfskraft="_profil.IstHilfskraft" NeueNachrichten="_neueNachrichten" ImChat="ImChat" />
        </MudDrawer>
    }

    <MudMainContent Class="@(ImChat ? "pt-16" : _angemeldet ? "pt-16 pa-4 mh-mit-leiste" : "pt-16 pa-4")">
        @if (WartetAufPruefung && AktuelleSeite != "profil")
        {
            @* Noch nicht geprüfte Hilfskraft: statt Chats nur der Hinweis (Profil bleibt erreichbar, um den Nachweis hochzuladen) *@
            <WarteAufPruefung NachweisHochgeladen="@(!string.IsNullOrEmpty(_details?.ProofUrl))" OnNeuPruefen="LadeAnmeldungNeuAsync" />
        }
        else
        {
            @Body
        }
    </MudMainContent>

    @* Leiste unten – nicht im geöffneten Chat (wie bei WhatsApp) *@
    @if (_angemeldet && _profil != null && !ImChat)
    {
        <UnterLeiste IstHilfskraft="_profil.IstHilfskraft" NeueNachrichten="_neueNachrichten" />
    }
</MudLayout>
</div>

@code {
    private bool _isDarkMode = false;
    private MudTheme? _theme;

    private bool _angemeldet;
    private bool _bereit;
    private bool _fensterOffen;
    private bool _notrufFensterOffen;
    private bool _neueNachrichten;
    private bool _menuOffen = true; // Laptop: Menü links, Handy: klappt automatisch weg
    private Profile? _profil;
    private HelperDetails? _details;   // nur bei Hilfskräften
    private bool _verifiziert;          // Hilfskraft vom mindhelp-Team geprüft?

    // Hilfskraft, deren Nachweis noch nicht geprüft wurde → darf noch niemandem schreiben
    private bool WartetAufPruefung => _angemeldet && _profil?.IstHilfskraft == true && !_verifiziert;
    private Guid? _meineId;

    // Auf diesen Seiten soll das Anmelde-Fenster nicht von selbst aufpoppen
    private static readonly string[] SeitenOhneLoginFenster = ["login", "register", "registeruser", "registerhelper"];

    private string AktuelleSeite => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].ToLowerInvariant();
    private bool ImChat => AktuelleSeite.StartsWith("chat/");

    protected override async Task OnInitializedAsync()
    {
        _theme = new()
        {
            PaletteLight = _lightPalette,
            PaletteDark = _darkPalette,
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "12px" }
        };

        // Gespeicherte Wahl hell/dunkel übernehmen (geändert wird sie im Profil)
        await Design.LadeAsync();
        _isDarkMode = Design.Dunkel;
        Design.Geaendert += BeiDesignGeaendert;


        await SupabaseService.InitializeAsync();
        SupabaseService.AnmeldungGeaendert += BeiAnmeldungGeaendert;
        Nav.LocationChanged += BeiSeitenwechsel;
        Chat.NeueNachricht += BeiNeuerNachricht;
        NotrufDienst.NotrufGeaendert += BeiNotruf;

        await LadeAnmeldungAsync();
        _bereit = true;
    }

    // Wer ist angemeldet, welche Rolle? Danach Live-Empfang für Chat und Notruf starten.
    private async Task LadeAnmeldungAsync()
    {
        _angemeldet = SupabaseService.IsLoggedIn;
        _profil = null;
        _details = null;
        _verifiziert = false;
        if (!_angemeldet)
        {
            Chat.StoppeLiveEmpfang();
            NotrufDienst.StoppeLiveEmpfang();
            return;
        }

        try
        {
            _meineId = await Chat.GetMeineIdAsync();
            _profil = await Chat.GetMeinProfilAsync();
            _details = _profil?.IstHilfskraft == true ? await Chat.GetHilfskraftDetailsAsync(_profil.Id) : null;
            _verifiziert = _details?.Verified == true;
            if (_profil?.IstHilfskraft == false)
                await NotrufDienst.LadeMeinenOffenenNotrufAsync();

            await Chat.StarteLiveEmpfangAsync();
            await NotrufDienst.StarteLiveEmpfangAsync();
        }
        catch (Exception ex)
        {
            // App funktioniert trotzdem, Neues erscheint dann erst nach dem Neuladen
            Console.WriteLine("Live-Empfang nicht möglich: " + ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Startlogo nach seiner Animation ganz entfernen, damit es beim wechseln der Seiten nie wieder auftaucht 
        if(firstRender)
        {
            await JS.InvokeVoidAsync("eval", "setTimeout(function() { var s = document.getElementById('splash');if (s) s.remove(); }, 7000);");
        }


        // Nach dem Start (das Logo liegt noch darüber): wer nicht angemeldet ist, bekommt das Anmelde-Fenster
        if (_bereit && !_angemeldet && !_fensterOffen && !_schonGezeigt && !IstSeiteOhneLoginFenster())
        {
            _schonGezeigt = true;
            await ZeigeLoginFenster();
        }
    }

    private bool _schonGezeigt;

    private bool IstSeiteOhneLoginFenster() => SeitenOhneLoginFenster.Contains(AktuelleSeite);

    private async Task ZeigeLoginFenster()
    {
        if (_fensterOffen) return;
        _fensterOffen = true;

        var optionen = new DialogOptions
        {
            BackdropClick = true,        // Klick daneben schließt das Fenster ebenfalls
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };
        var fenster = await DialogService.ShowAsync<LoginDialog>(string.Empty, optionen);
        await fenster.Result;

        _fensterOffen = false;
    }

    private async Task ZeigeRegistrierung()
    {
        var optionen = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<RegisterDialog>(string.Empty, optionen);
    }

    private async Task ZeigeNotruf()
    {
        _notrufFensterOffen = true;
        var optionen = new DialogOptions { BackdropClick = false, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var fenster = await DialogService.ShowAsync<NotrufDialog>(string.Empty, optionen);
        await fenster.Result;
        _notrufFensterOffen = false;
        StateHasChanged();   // SOS-Knopf zeigt evtl. "wartet …"
    }

    // Hilfesuchende: Notruf wurde angenommen, während das Fenster zu war → Hinweis mit Knopf zum Chat
    private void BeiNotruf(Notruf notruf)
    {
        _ = InvokeAsync(() =>
        {
            if (_profil?.IstHilfskraft == false && notruf.UserId == _meineId && notruf.Status == "angenommen"
                && !_notrufFensterOffen && notruf.ConversationId is { } unterhaltung)
            {
                NotrufDienst.VergissMeinenNotruf();
                Snackbar.Add("Eine Hilfskraft hat deinen Notruf angenommen.", Severity.Success, konfig =>
                {
                    konfig.RequireInteraction = true;
                    konfig.Action = "Zum Chat";
                    konfig.OnClick = _ => { Nav.NavigateTo($"chat/{unterhaltung}"); return Task.CompletedTask; };
                });
            }
            StateHasChanged();
        });
    }

    // Roter Punkt beim Chat, wenn eine Nachricht kommt und man gerade woanders ist
    private void BeiNeuerNachricht(ChatMessage nachricht)
    {
        if (nachricht.SenderId == _meineId || AktuelleSeite == "" || ImChat) return;
        _neueNachrichten = true;
        InvokeAsync(StateHasChanged);
    }

    private void BeiSeitenwechsel(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (AktuelleSeite == "" || ImChat) _neueNachrichten = false;
        InvokeAsync(StateHasChanged);
    }

        // Knopf "Erneut prüfen" auf der Warteseite
    private async Task LadeAnmeldungNeuAsync()
    {
        await LadeAnmeldungAsync();
        StateHasChanged();
    }


    private void BeiAnmeldungGeaendert()
    {
        _ = InvokeAsync(async () =>
        {
            await LadeAnmeldungAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        SupabaseService.AnmeldungGeaendert -= BeiAnmeldungGeaendert;
        Nav.LocationChanged -= BeiSeitenwechsel;
        Chat.NeueNachricht -= BeiNeuerNachricht;
        NotrufDienst.NotrufGeaendert -= BeiNotruf;
        Design.Geaendert -= BeiDesignGeaendert;
    }

        private void BeiDesignGeaendert()
    {
        _isDarkMode = Design.Dunkel;
        InvokeAsync(StateHasChanged);
    }

    // Farben passend zum mindhelp-Logo (Lila / Flieder)
    private readonly PaletteLight _lightPalette = new()
    {
        Primary = "#7E6FD8",
        Secondary = "#A9C4EB",
        Tertiary = "#C9B8F0",
        Background = "#F7F5FC",
        Surface = "#FFFFFF",
        AppbarBackground = "rgba(255,255,255,0.65)",
        AppbarText = "#4B4470",
        DrawerBackground = "rgba(255,255,255,0.55)",
        DrawerText = "#4B4470",
        DrawerIcon = "#7E6FD8",
        TextPrimary = "#2E2A47",
        TextSecondary = "#6E6A85",
        GrayLight = "#ECE9F6",
        GrayLighter = "#F7F5FC",
    };

    private readonly PaletteDark _darkPalette = new()
    {
        Primary = "#7e6fff",
        Surface = "#1e1e2d",
        Background = "#1a1a27",
        BackgroundGray = "#151521",
        AppbarText = "#92929f",
        AppbarBackground = "rgba(26,26,39,0.8)",
        DrawerBackground = "rgba(26,26,39,0.7)",
        ActionDefault = "#74718e",
        ActionDisabled = "#9999994d",
        ActionDisabledBackground = "#605f6d4d",
        TextPrimary = "#b2b0bf",
        TextSecondary = "#92929f",
        TextDisabled = "#ffffff33",
        DrawerIcon = "#92929f",
        DrawerText = "#92929f",
        GrayLight = "#2a2833",
        GrayLighter = "#1e1e2d",
        Info = "#4a86ff",
        Success = "#3dcb6c",
        Warning = "#ffb545",
        Error = "#ff3f5f",
        LinesDefault = "#33323e",
        TableLines = "#33323e",
        Divider = "#292838",
        OverlayLight = "#1e1e2d80",
    };

    
}