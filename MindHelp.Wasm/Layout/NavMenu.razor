@implements IDisposable
@inject SupaBaseService SupabaseService

<MudNavMenu>
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Startseite</MudNavLink>

    @if (SupabaseService.IsLoggedIn)
    {
        @* Nur für angemeldete Personen *@
        <MudNavLink Href="profil" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ManageAccounts">Mein Profil</MudNavLink>
    }
</MudNavMenu>

@code {
    protected override void OnInitialized()
    {
        SupabaseService.AnmeldungGeaendert += Aktualisieren;
    }

    private void Aktualisieren() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SupabaseService.AnmeldungGeaendert -= Aktualisieren;
    }
}